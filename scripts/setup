#!/usr/bin/env bash
# Setups the repository.

# Stop on errors
set -e

cd "$(dirname "$0")/.."

# Setup venv if it does not exist yet
if [ ! -d ".venv" ]; then
  virtualenv .venv
fi

VENV_BIN="${PWD}/.venv/bin"
PYTHON_BIN="${VENV_BIN}/python"
HASS_BIN="${VENV_BIN}/hass"

# Install packages
sudo apt-get update
sudo apt-get install -y libpcap-dev ffmpeg

# Install python dependencies
echo "Installing development dependencies..."
"${PYTHON_BIN}" -m pip install -r requirements.txt

# Create config folder if does not exist
mkdir -p config

"${HASS_BIN}" --script ensure_config -c config

if ! grep -R "logger" config/configuration.yaml >> /dev/null;then
echo "
logger:
  default: info
  logs:
    custom_components.atomberg: debug
" >> config/configuration.yaml
fi